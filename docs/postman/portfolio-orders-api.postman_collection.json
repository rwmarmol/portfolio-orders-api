    {
      "name": "Orders - accepted",
      "description": "Valid orders. They are written to the database: run them against the local compose Postgres only.",
      "item": [
        {
          "name": "MARKET BUY by quantity",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 201', () => pm.response.to.have.status(201));",
                  "const order = pm.response.json();",
                  "pm.test('order is stored as FILLED', () => pm.expect(order.status).to.eql('FILLED'));",
                  "pm.test('order has an id and an ISO datetime', () => {",
                  "  pm.expect(order.id).to.be.a('number');",
                  "  pm.expect(new Date(order.datetime).toISOString()).to.eql(order.datetime);",
                  "});",
                  "pm.test('executes at a 2-decimal market price', () => pm.expect(order.price).to.match(/^-?\\d+\\.\\d{2}$/));",
                  "pm.test('has no rejection reason', () => pm.expect(order.reason).to.eql(undefined));",
                  "pm.test('quantity is the one requested', () => pm.expect(order.size).to.eql(1));",
                  "pm.collectionVariables.set('filledOrderId', order.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/users/{{userId}}/orders",
              "host": ["{{baseUrl}}"],
              "path": ["users", "{{userId}}", "orders"]
            },
            "description": "Executes immediately at the latest close, which is stored as the order price.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"instrumentId\": {{instrumentId}},\n  \"side\": \"BUY\",\n  \"type\": \"MARKET\",\n  \"quantity\": 1\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "LIMIT BUY by quantity",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 201', () => pm.response.to.have.status(201));",
                  "const order = pm.response.json();",
                  "pm.test('order is stored as NEW', () => pm.expect(order.status).to.eql('NEW'));",
                  "pm.test('order has an id and an ISO datetime', () => {",
                  "  pm.expect(order.id).to.be.a('number');",
                  "  pm.expect(new Date(order.datetime).toISOString()).to.eql(order.datetime);",
                  "});",
                  "pm.test('keeps the price sent by the user', () => pm.expect(order.price).to.eql('100.00'));",
                  "pm.collectionVariables.set('limitOrderId', order.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/users/{{userId}}/orders",
              "host": ["{{baseUrl}}"],
              "path": ["users", "{{userId}}", "orders"]
            },
            "description": "Stored as NEW with the user's price. Nothing executes it (no market simulation); its pesos count as committed.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"instrumentId\": {{instrumentId}},\n  \"side\": \"BUY\",\n  \"type\": \"LIMIT\",\n  \"quantity\": 1,\n  \"price\": \"100.00\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "MARKET BUY by amount",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 201', () => pm.response.to.have.status(201));",
                  "const order = pm.response.json();",
                  "pm.test('order is stored as FILLED', () => pm.expect(order.status).to.eql('FILLED'));",
                  "pm.test('order has an id and an ISO datetime', () => {",
                  "  pm.expect(order.id).to.be.a('number');",
                  "  pm.expect(new Date(order.datetime).toISOString()).to.eql(order.datetime);",
                  "});",
                  "pm.test('quantity is the maximum whole number of shares that fits the amount', () => {",
                  "  const price = Number(order.price);",
                  "  pm.expect(order.size * price).to.be.at.most(5000);",
                  "  pm.expect((order.size + 1) * price).to.be.above(5000);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/users/{{userId}}/orders",
              "host": ["{{baseUrl}}"],
              "path": ["users", "{{userId}}", "orders"]
            },
            "description": "The amount is converted into the maximum whole number of shares.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"instrumentId\": {{instrumentId}},\n  \"side\": \"BUY\",\n  \"type\": \"MARKET\",\n  \"amount\": \"5000\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "MARKET SELL of owned shares",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 201', () => pm.response.to.have.status(201));",
                  "const order = pm.response.json();",
                  "pm.test('order is stored as FILLED', () => pm.expect(order.status).to.eql('FILLED'));",
                  "pm.test('order has an id and an ISO datetime', () => {",
                  "  pm.expect(order.id).to.be.a('number');",
                  "  pm.expect(new Date(order.datetime).toISOString()).to.eql(order.datetime);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/users/{{userId}}/orders",
              "host": ["{{baseUrl}}"],
              "path": ["users", "{{userId}}", "orders"]
            },
            "description": "Succeeds because the user holds shares of the instrument (net of NEW LIMIT SELL commitments).",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"instrumentId\": {{instrumentId}},\n  \"side\": \"SELL\",\n  \"type\": \"MARKET\",\n  \"quantity\": 1\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    },
    {
      "name": "Orders - cancellation",
      "description": "Cancellation of NEW orders. Run after `Orders - accepted`: it uses the order ids stored by that folder.",
      "item": [
        {
          "name": "Cancel a NEW LIMIT order",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "const order = pm.response.json();",
                  "pm.test('order is the one created by the LIMIT BUY request', () => pm.expect(order.id).to.eql(Number(pm.collectionVariables.get('limitOrderId'))));",
                  "pm.test('order is now CANCELLED', () => pm.expect(order.status).to.eql('CANCELLED'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/users/{{userId}}/orders/{{limitOrderId}}/cancel",
              "host": ["{{baseUrl}}"],
              "path": ["users", "{{userId}}", "orders", "{{limitOrderId}}", "cancel"]
            },
            "description": "Only NEW orders can be cancelled. The pesos it committed are released automatically. Depends on `LIMIT BUY by quantity`, which stores the order id in `limitOrderId`."
          }
        },
        {
          "name": "Cancel the same order again (idempotent)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "const order = pm.response.json();",
                  "pm.test('succeeds again and the order stays CANCELLED', () => pm.expect(order.status).to.eql('CANCELLED'));",
                  "pm.test('it is the same order', () => pm.expect(order.id).to.eql(Number(pm.collectionVariables.get('limitOrderId'))));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/users/{{userId}}/orders/{{limitOrderId}}/cancel",
              "host": ["{{baseUrl}}"],
              "path": ["users", "{{userId}}", "orders", "{{limitOrderId}}", "cancel"]
            },
            "description": "Repeating a cancellation is safe: it answers 200 with the same order and changes nothing, so clients can retry after a network failure."
          }
        },
        {
          "name": "Cancel a FILLED order",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 409', () => pm.response.to.have.status(409));",
