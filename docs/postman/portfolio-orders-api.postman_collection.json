    {
      "name": "Orders - rejected (stored, HTTP 201)",
      "description": "Business rejections are stored and returned with status REJECTED and a reason.",
      "item": [
        {
          "name": "BUY without enough pesos",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 201', () => pm.response.to.have.status(201));",
                  "const order = pm.response.json();",
                  "pm.test('order is stored as REJECTED', () => pm.expect(order.status).to.eql('REJECTED'));",
                  "pm.test('order has an id and an ISO datetime', () => {",
                  "  pm.expect(order.id).to.be.a('number');",
                  "  pm.expect(new Date(order.datetime).toISOString()).to.eql(order.datetime);",
                  "});",
                  "pm.test('reason is insufficient funds', () => pm.expect(order.reason).to.eql('insufficient funds'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/users/{{userId}}/orders",
              "host": ["{{baseUrl}}"],
