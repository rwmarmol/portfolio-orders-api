{
  "info": {
    "name": "Portfolio & Orders API",
    "description": "One request per case, with basic assertions. Use it with the `local` environment against the local docker-compose Postgres: the order requests WRITE orders for user 1, so never point `baseUrl` at an API connected to a shared or remote database. Reset the data with `docker compose down -v`.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Health",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 200', () => pm.response.to.have.status(200));",
              "pm.test('database is up', () => pm.expect(pm.response.json()).to.eql({ status: 'ok', db: 'up' }));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": ["{{baseUrl}}"],
          "path": ["health"]
        },
        "description": "Liveness and database check. Returns 503 with `db: down` when the database does not answer."
      }
    },
    {
      "name": "Portfolio",
      "description": "",
      "item": [
        {
          "name": "Portfolio of a user",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('money fields are 2-decimal strings', () => ['availablePesos', 'committedPesos', 'totalValue'].forEach((k) => pm.expect(body[k]).to.match(/^-?\\d+\\.\\d{2}$/)));",
                  "pm.test('total value is cash plus the priced positions', () => {",
                  "  const sum = body.positions.reduce((acc, p) => acc + (p.marketValue === null ? 0 : Number(p.marketValue)), Number(body.availablePesos));",
                  "  pm.expect(Math.abs(sum - Number(body.totalValue))).to.be.below(0.01 * (body.positions.length + 1));",
                  "});",
                  "pm.test('totalIsPartial is a boolean', () => pm.expect(body.totalIsPartial).to.be.a('boolean'));",
                  "pm.test('seed position of instrument 31 stays negative and has no total return', () => {",
                  "  const p = body.positions.find((x) => x.instrumentId === 31);",
                  "  pm.expect(p.quantity).to.eql(-10);",
                  "  pm.expect(p.averageCost).to.eql(null);",
                  "  pm.expect(p.totalReturnPct).to.eql(null);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/users/{{userId}}/portfolio",
              "host": ["{{baseUrl}}"],
              "path": ["users", "{{userId}}", "portfolio"]
            },
            "description": "Available pesos, pesos committed by NEW LIMIT BUY orders, total value and positions with returns. Assertions are relative so the request passes after other requests have created orders. Exact seed values (753000.00 / 125500.00 / 40 / -10 / 500) hold on a freshly seeded database only."
          }
        },
        {
          "name": "Portfolio of an unknown user",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 404', () => pm.response.to.have.status(404));",
                  "const body = pm.response.json();",
                  "pm.test('error code is NOT_FOUND', () => pm.expect(body.error).to.eql('NOT_FOUND'));",
                  "pm.test('error body carries a request id', () => pm.expect(body.requestId).to.be.a('string'));",
                  "pm.test('x-request-id header is returned', () => pm.expect(pm.response.headers.get('x-request-id')).to.be.a('string'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/users/{{unknownUserId}}/portfolio",
              "host": ["{{baseUrl}}"],
              "path": ["users", "{{unknownUserId}}", "portfolio"]
            },
            "description": "A user that does not exist is a 404."
          }
        },
        {
          "name": "Portfolio with a malformed user id",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 400', () => pm.response.to.have.status(400));",
                  "const body = pm.response.json();",
                  "pm.test('error code is VALIDATION_ERROR', () => pm.expect(body.error).to.eql('VALIDATION_ERROR'));",
                  "pm.test('error body carries a request id', () => pm.expect(body.requestId).to.be.a('string'));",
                  "pm.test('x-request-id header is returned', () => pm.expect(pm.response.headers.get('x-request-id')).to.be.a('string'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/users/abc/portfolio",
              "host": ["{{baseUrl}}"],
              "path": ["users", "abc", "portfolio"]
            },
            "description": "The path parameter must be a positive integer."
          }
        }
      ]
    },
    {
      "name": "Instruments",
      "description": "",
      "item": [
        {
          "name": "Search by ticker prefix or name",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "const items = pm.response.json().items;",
                  "pm.test('returns matches', () => pm.expect(items.length).to.be.above(0));",
                  "pm.test('every item matches the query in ticker or name (case-insensitive)', () =>",
                  "  items.forEach((i) => pm.expect((i.ticker + ' ' + i.name).toLowerCase()).to.include('pa')));",
                  "pm.test('ticker prefix matches come first', () => pm.expect(items[0].ticker.toLowerCase().startsWith('pa')).to.eql(true));",
                  "pm.test('the cash instrument is never returned', () => items.forEach((i) => pm.expect(i.type).to.not.eql('MONEDA')));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/instruments?q=pa",
              "host": ["{{baseUrl}}"],
              "path": ["instruments"],
              "query": [
                {
                  "key": "q",
                  "value": "pa"
                }
              ]
            },
            "description": "Partial, case-insensitive match. Order: exact ticker, ticker prefix, name contains, ticker contains."
          }
        },
